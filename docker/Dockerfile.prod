FROM node:lts-alpine3.22 AS build

WORKDIR /app

COPY package*.json .

RUN npm ci

COPY . .

RUN npm run build


FROM node:lts-alpine3.22 AS production

RUN addgroup app && adduser -S -G app app

WORKDIR /app

COPY --from=build /app/dist ./dist

COPY --from=build /app/package*.json .

RUN npm ci --omit=dev

USER app

EXPOSE 1234

CMD ["node", "./dist/index.js"]